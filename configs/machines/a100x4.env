# 4x A100-80GB server (Docker). Host volume /mnt/dekel is mounted as /data; repos in /data/repos, envs in /data/envs,
# HF cache in /data/hf_cache. The pipeline brings up docker/docker-compose.yml (gpus all, network_mode host, ipc host,
# which covers the old --shm-size=16g). Setup and runs: docs/reproduce.md §5.
# The agent runs ON this server (no SSH_HOST). If it runs INSIDE an already-started container, prefix commands with IN_CONTAINER=1.
RUNNER=docker
SSH_HOST=
HOST_DATA=/mnt/dekel
HOST_ENVS=/mnt/dekel/envs
HOST_NLP=/mnt/dekel/repos
HOST_REPO=/mnt/dekel/repos/relations_extraction_llm_finetune
DOCKER="docker"
COMPOSE_PROJECT=relx
CONTAINER=relx-dev-1
REPO=/data/repos/relations_extraction_llm_finetune
HF_HOME=/data/hf_cache
ENV_VLLM=/data/envs/re-vllm
ENV_UNSLOTH=/data/envs/re-unsloth
MANAGE_ENVS=1
# versions used for the reported A100 runs (vLLM env / Unsloth env)
VLLM_PKGS="vllm==0.33.0"
UNSLOTH_PKGS="unsloth==2026.11.4 unsloth_zoo==2026.11.4 transformers==5.17.0 trl==1.15.0 peft==0.21.3 bitsandbytes==0.50.2"
# single-GPU pipeline: pick the GPU (watchdog: --gpu N to match). Run other GPUs with a 2nd clone/config.
GPU_IDS=0
EXTRA_EXPORTS='export CUDA_VISIBLE_DEVICES=$GPU_IDS PATH=/data/envs/re-vllm/bin:$PATH CC=/data/envs/re-vllm/bin/gcc VLLM_USE_FLASHINFER_SAMPLER=0 PYTHONPATH=/data/repos/llm_providers'
GPU_MEM=0.92
MAX_MODEL_LEN=8192
MAX_NUM_SEQS=64
# ENGINE_KW unset: 27B run configs set BASE_*_ENGINE_KW (language_model_only etc.); 4B is text-only
ENFORCE_EAGER=0
KV_CACHE_DTYPE=
PROGRESS_EVERY=300
