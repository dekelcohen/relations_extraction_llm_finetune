# Same host/GPU0/env/cache as a100x4-dekel9b, but a separate container (relx8b-dev) and checkout:
# /mnt/dekel/relx-qwen35-9b/qwen3-8b-run/repo is mounted at /data/repo, so the 9B repo and results stay untouched.
RUNNER=docker
SSH_HOST=
HOST_DATA=/mnt/dekel/relx-qwen35-9b
DOCKER="docker"
CONTAINER=relx8b-dev
REPO=/data/repo
HF_HOME=/data/hf_cache
ENV_VLLM=/data/envs/re-vllm
ENV_UNSLOTH=/data/envs/re-vllm
MANAGE_ENVS=0
GPU_IDS=0
EXTRA_EXPORTS='export CUDA_VISIBLE_DEVICES=$GPU_IDS PATH=/data/envs/re-vllm/bin:$PATH CC=/data/envs/re-vllm/bin/gcc VLLM_USE_FLASHINFER_SAMPLER=0'
GPU_MEM=0.88
MAX_MODEL_LEN=8192
MAX_NUM_SEQS=64
ENFORCE_EAGER=0
KV_CACHE_DTYPE=
PROGRESS_EVERY=300
