# Local RTX 3070 8GB, existing gpu-dev compose stack (docker needs sudo). Reproduces the Qwen3-4B setup.
RUNNER=docker
SSH_HOST=
HOST_NLP=/home/dekelco/NLP
HOST_ENVS=/home/dekelco/envs
HOST_DATA=/home/dekelco/data
HOST_REPO=/home/dekelco/NLP/relations_extraction_llm_finetune
DOCKER="sudo -n docker"
COMPOSE_PROJECT=gpu-dev
CONTAINER=gpu-dev-dev-1
REPO=/NLP/relations_extraction_llm_finetune
HF_HOME=/data/.cache/huggingface
ENV_VLLM=/data/envs/re
ENV_UNSLOTH=/data/envs/re
MANAGE_ENVS=0
EXTRA_EXPORTS='export PATH=/data/envs/re/bin:$PATH CC=/data/envs/re/bin/gcc VLLM_USE_FLASHINFER_SAMPLER=0'
GPU_MEM=0.9
MAX_MODEL_LEN=8192
MAX_NUM_SEQS=
ENFORCE_EAGER=1
KV_CACHE_DTYPE=
