# Qwen3-8B eval with vLLM on the bf16 base; the QLoRA adapters (trained on the bnb-4bit base) are served as vLLM LoRA.
# Unsloth/HF bnb-4bit generate measured 0.6 prompts/min on the A100 (14-prompt test_long smoke), too slow for full sets.
. "$(dirname "${BASH_SOURCE[0]}")/qwen3-8b.env"
EVAL_BASES="bf16"
MODEL=Qwen/Qwen3-8B
QUANT=
DOWNLOAD=$MODEL
BACKEND=vllm
EVAL_ENV=$ENV_VLLM
ENGINE_KW='{}'
