# 4B(3.5) stage 2 = same recipe as qwen3-4b-stage2.env: continue the Qwen3.5-4B stage-1 adapter on the
# rejection-sampled self-distill set (994 chunk rows), lr 5e-5, 2 epochs. Same hf-backend caveat as qwen3.5-4b.env
# (no AWQ/vLLM-quant checkpoint for this model yet).
. "$(dirname "${BASH_SOURCE[0]}")/qwen3.5-4b.env"
EVAL_SETS="pilot grpo_dev test_long hard_inss"
SFT_TRAIN=data/sft_stage2/train_selfdistill.jsonl
SFT_INIT_ADAPTER=outputs/sft-cot-qwen3.5-4b
SFT_OUT=outputs/sft-cot-qwen3.5-4b-stage2
SFT_LR=5e-5
SFT_WARMUP=0.05
FT_NAME=qwen3.5-4b-ft-stage2
STAGES="sft_smoke sft ft_eval"
