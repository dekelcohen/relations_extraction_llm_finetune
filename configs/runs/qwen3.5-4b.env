# Qwen3.5-4B = same recipe as qwen3-4b.env, swapped to the new qwen3_5 architecture (`Qwen3_5ForCausalLM`).
# No pre-quantized `-unsloth-bnb-4bit` or `-AWQ` checkpoint exists yet for this model (checked HF 2026-11-18):
# SFT loads the bf16 repo with on-the-fly bitsandbytes 4-bit (unsloth `load_in_4bit=True`, same as training);
# eval has no AWQ/vLLM-quant checkpoint either, so it uses the `hf` backend (`eval/predict.py --backend hf`,
# `transformers.AutoModelForCausalLM` + `.generate()`, bitsandbytes 4-bit) instead of vLLM.
# Confirmed on local3070 (2026-11-18): unsloth 2026.11.4 / transformers 5.17.0 load+patch
# `unsloth/Qwen3.5-4B` in 4-bit ("Fast Qwen3_5 patching"); same <think> chat template as Qwen3.
EVAL_BASES="bnb4"
BASE_BNB4_MODEL=unsloth/Qwen3.5-4B
BASE_BNB4_QUANT=bitsandbytes
BACKEND=hf
EVAL_ENV=$ENV_UNSLOTH
EVAL_NAME=qwen3.5-4b
DOWNLOAD="unsloth/Qwen3.5-4B"
EVAL_SETS="pilot grpo_dev test_long"
ENABLE_THINKING=1
TEMPERATURE=0.6
TOP_P=0.95
TOP_K=20
MAX_TOKENS=5120
MAX_LORA_RANK=32
SFT_BASE=unsloth/Qwen3.5-4B
SFT_OUT=outputs/sft-cot-qwen3.5-4b
SFT_TRAIN=data/synth_hefa/sft_cot_train.jsonl
SFT_R=32
SFT_EPOCHS=2
SFT_LR=1e-4
SFT_BS=1
SFT_GA=16
SFT_VAL_FRAC=0.08
SFT_MAX_LEN=auto
FT_NAME=qwen3.5-4b-ft
STAGES="base_eval sft_smoke sft ft_eval"
