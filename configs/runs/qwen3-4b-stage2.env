# 4B stage 2 = same recipe as qwen3.8-27b-stage2 (apples-to-apples): continue the 4B stage-1 adapter on the
# rejection-sampled self-distill set (994 chunk rows: stage-2 synth + INSS train + stage-1 replay), lr 5e-5, 2 epochs.
# Qwen3-4B has no reasoning_effort in its template, so no SFT_CHAT_KW (eval uses the same default thinking).
. "$(dirname "${BASH_SOURCE[0]}")/qwen3-4b.env"
EVAL_SETS="pilot grpo_dev test_long hard_inss"
SFT_TRAIN=data/sft_stage2/train_selfdistill.jsonl
SFT_INIT_ADAPTER=outputs/sft-cot-qwen3-4b
SFT_OUT=outputs/sft-cot-qwen3-4b-stage2
SFT_LR=5e-5
SFT_WARMUP=0.05
FT_NAME=qwen3-4b-ft-stage2
STAGES="sft_smoke sft ft_eval"
