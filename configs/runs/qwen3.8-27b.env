# Base Qwen3.8-27B (FP8) eval + 4-bit QLoRA SFT replicating sft-cot-qwen3-4b.
# eval columns: <EVAL_NAME>-<base>, fine-tuned: <FT_NAME>-<base> (same base list)
EVAL_BASES="int4"   # fp8 base eval is done (extra column); int4 = fast vLLM config. bnb4 base eval dropped (vLLM bnb too slow); bnb4 stays the SFT base
BASE_FP8_MODEL=Qwen/Qwen3.8-27B-FP8
BASE_FP8_QUANT=
BASE_INT4_MODEL=RedHatAI/Qwen3.8-27B-INT4
BASE_INT4_QUANT=
BASE_INT4_GPU_MEM=0.93
BASE_INT4_MAX_NUM_SEQS=48   # bf16 KV ~64 KB/token: ~48 seqs of ~6k tokens fit; 96 only preempts
BASE_INT4_ENGINE_KW='{"language_model_only": true, "attention_backend": "TRITON_ATTN", "kv_cache_dtype": "bfloat16", "enable_prefix_caching": false, "mamba_ssm_cache_dtype": "bfloat16", "max_num_batched_tokens": 8192}'  # bf16 KV explicit (the checkpoint defaults to fp8 KV, needs sm89+); TRITON_ATTN: the auto-picked FLASHINFER JIT-compiles and needs nvcc (none in the env)
BASE_INT4_MAX_TOKENS=12288   # fp8 column used 5120 (most invalid JSON there = thinking cut at max_tokens)
BASE_INT4_MAX_MODEL_LEN=16384
# int4-medium: same engine, chat template reasoning_effort=medium (template default xhigh overthinks: 27% max_tokens hits on test_long)
BASE_INT4_MEDIUM_MODEL=$BASE_INT4_MODEL
BASE_INT4_MEDIUM_QUANT=
BASE_INT4_MEDIUM_GPU_MEM=$BASE_INT4_GPU_MEM
BASE_INT4_MEDIUM_MAX_NUM_SEQS=$BASE_INT4_MAX_NUM_SEQS
BASE_INT4_MEDIUM_ENGINE_KW=$BASE_INT4_ENGINE_KW
BASE_INT4_MEDIUM_MAX_TOKENS=$BASE_INT4_MAX_TOKENS
BASE_INT4_MEDIUM_MAX_MODEL_LEN=$BASE_INT4_MAX_MODEL_LEN
BASE_INT4_MEDIUM_CHAT_KW='{"reasoning_effort": "medium"}'
BASE_BNB4_MODEL=unsloth/Qwen3.8-27B-unsloth-bnb-4bit
BASE_BNB4_QUANT=bitsandbytes
EVAL_NAME=qwen3.8-27b
DOWNLOAD="RedHatAI/Qwen3.8-27B-INT4 Qwen/Qwen3.8-27B-FP8 unsloth/Qwen3.8-27B-unsloth-bnb-4bit"
EVAL_SETS="pilot grpo_dev test_long"
ENABLE_THINKING=1
TEMPERATURE=0.6
TOP_P=0.95
TOP_K=20
MAX_TOKENS=5120
MAX_LORA_RANK=32
SFT_BASE=unsloth/Qwen3.8-27B-unsloth-bnb-4bit
SFT_OUT=outputs/sft-cot-qwen3.8-27b
SFT_TRAIN=data/synth_hefa/sft_cot_train.jsonl
SFT_R=32
SFT_EPOCHS=2
SFT_LR=1e-4
SFT_BS=1
SFT_GA=16
SFT_VAL_FRAC=0.08
SFT_MAX_LEN=auto
FT_NAME=qwen3.8-27b-ft
STAGES="setup_vllm download_eval ; base_eval | setup_unsloth download_sft ; sft_smoke sft ft_eval"
