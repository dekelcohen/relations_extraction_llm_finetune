# Base Qwen3.8-27B (FP8) eval + 4-bit QLoRA SFT replicating sft-cot-qwen3-4b.
MODEL=Qwen/Qwen3.8-27B-FP8
QUANT=
EVAL_NAME=qwen3.8-27b
DOWNLOAD="Qwen/Qwen3.8-27B-FP8 unsloth/Qwen3.8-27B-unsloth-bnb-4bit"
EVAL_SETS="pilot grpo_dev test_long"
ENABLE_THINKING=1
TEMPERATURE=0.6
TOP_P=0.95
TOP_K=20
MAX_TOKENS=5120
MAX_LORA_RANK=32
SFT_BASE=unsloth/Qwen3.8-27B-unsloth-bnb-4bit
SFT_OUT=outputs/sft-cot-qwen3.8-27b
SFT_TRAIN=data/synth_hefa/sft_cot_train.jsonl
SFT_R=32
SFT_EPOCHS=2
SFT_LR=1e-4
SFT_BS=1
SFT_GA=16
SFT_VAL_FRAC=0.08
SFT_MAX_LEN=auto
FT_NAME=qwen3.8-27b-ft
FT_MODEL=Qwen/Qwen3.8-27B-FP8
FT_QUANT=
FT_FALLBACK_MODEL=unsloth/Qwen3.8-27B-unsloth-bnb-4bit
FT_FALLBACK_QUANT=bitsandbytes
STAGES="setup download smoke base_eval sft_smoke sft ft_eval"
