# Single-GPU Unsloth QLoRA on the same stage-1 rows as Qwen3.5-9B.
. "$(dirname "${BASH_SOURCE[0]}")/qwen3-4b.env"
EVAL_BASES="bnb4"
BASE_BNB4_MODEL=unsloth/Qwen3-8B-unsloth-bnb-4bit
BASE_BNB4_QUANT=bitsandbytes
BACKEND=unsloth
EVAL_ENV=$ENV_UNSLOTH
EVAL_NAME=qwen3-8b
EVAL_SETS="pilot test_long hard_inss"
MAX_MODEL_LEN=16384
MAX_TOKENS=8192
HF_BATCH_SIZE=16
SFT_BASE=$BASE_BNB4_MODEL
DOWNLOAD=$SFT_BASE
SFT_OUT=outputs/sft-cot-qwen3-8b
FT_NAME=qwen3-8b-ft
SFT_CHAT_KW='{"normalize_think_tags":true}'
STAGES="download_sft smoke sft_smoke sft base_eval ft_eval"
