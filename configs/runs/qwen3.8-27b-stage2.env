# Stage 2: continue the stage-1 adapter on data/sft_stage2/train.jsonl (weights only, fresh optimizer). Inherits the stage-1 run config.
. "$(dirname "${BASH_SOURCE[0]}")/qwen3.8-27b.env"
EVAL_BASES="int4"
EVAL_SETS="pilot grpo_dev test_long hard_inss"
SFT_TRAIN=data/sft_stage2/train.jsonl
SFT_INIT_ADAPTER=outputs/sft-cot-qwen3.8-27b
SFT_OUT=outputs/sft-cot-qwen3.8-27b-stage2
SFT_LR=5e-5
SFT_WARMUP=0.05
FT_NAME=qwen3.8-27b-ft-stage2
STAGES="sft_smoke sft ft_eval"
# self-distillation: base-INT4-medium traces (rejection sampled), trained under the same reasoning_effort=medium instruction
SFT_TRAIN=data/sft_stage2/train_selfdistill.jsonl
SFT_CHAT_KW='{"reasoning_effort": "medium"}'
STAGES="selfdistill_gen"
