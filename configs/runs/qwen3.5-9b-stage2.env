# Continue the 9B stage-1 adapter on the shared stage-2 self-distillation set.
. "$(dirname "${BASH_SOURCE[0]}")/qwen3.5-9b.env"
SFT_TRAIN=data/sft_stage2/train_selfdistill.jsonl
SFT_INIT_ADAPTER=outputs/sft-cot-qwen3.5-9b
SFT_OUT=outputs/sft-cot-qwen3.5-9b-stage2
SFT_LR=5e-5
SFT_WARMUP=0.05
FT_NAME=qwen3.5-9b-ft-stage2
STAGES="sft_smoke sft"
